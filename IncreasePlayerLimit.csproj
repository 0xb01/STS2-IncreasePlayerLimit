<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>IncreasePlayerLimit</RootNamespace>
    <AssemblyName>IncreasePlayerLimit</AssemblyName>
    <PackageId>IncreasePlayerLimit</PackageId>
    <Title>IncreasePlayerLimit</Title>
    <Product>IncreasePlayerLimit</Product>
    <Description>A Slay the Spire 2 multiplayer mod that lifts the vanilla 4-player lobby limit.</Description>
    <Authors>0xb1</Authors>
    <Version>0.1.4</Version>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build\**\*.cs" />
    <Reference Include="0Harmony">
      <HintPath Condition="Exists('libs\0Harmony.dll')">libs\0Harmony.dll</HintPath>
      <HintPath Condition="!Exists('libs\0Harmony.dll')">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath Condition="Exists('libs\sts2.dll')">libs\sts2.dll</HintPath>
      <HintPath Condition="!Exists('libs\sts2.dll')">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <MakeDir Directories="$(ProjectDir)build\IncreasePlayerLimit" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)build\IncreasePlayerLimit" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)IncreasePlayerLimit.json" DestinationFolder="$(ProjectDir)build\IncreasePlayerLimit" SkipUnchangedFiles="true" />
    <Exec Command="python &quot;$(ProjectDir)tools\pack_pck.py&quot;" ContinueOnError="true" StandardOutputImportance="High" />
    <Copy Condition="Exists('$(ProjectDir)build\IncreasePlayerLimit.pck')" SourceFiles="$(ProjectDir)build\IncreasePlayerLimit.pck" DestinationFolder="$(ProjectDir)build\IncreasePlayerLimit" SkipUnchangedFiles="false" />
  </Target>
</Project>
